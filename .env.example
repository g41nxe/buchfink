# Vorlage. Kopieren nach `.env` — die bleibt aus dem Repository draussen.

# Zeitzone des Containers. Die Anwendung rechnet in lokaler Zeit (ADR 12).
TZ=Europe/Berlin

# Das Bewertungstor urteilt ueber jeden Fund und haelt zurueck, was unter drei
# Sternen bleibt. Es braucht dafuer einen der beiden folgenden Eintraege; sind
# beide leer, erscheint alles unbewertet — kein Fehler, nur kein Tor.

# Weg 1: ein Schluessel aus der Anthropic Console. Geht vor, wo beides steht.
# API-Zugang ist in keinem Claude-Abo enthalten, die Console rechnet getrennt
# ab.
ANTHROPIC_API_KEY=

# Weg 2: die im Bild mitgebaute `claude`-CLI. Den Token erzeugt
#
#     claude setup-token
#
# auf deinem Rechner — er ist langlebig und haengt am Abonnement, kostet also
# kein zusaetzliches Guthaben. Wie jedes Geheimnis gehoert er in diese Datei
# und in kein Repository.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Wohin der Tagesbericht als Benachrichtigung geht (#98) — eine
# Apprise-Adresse, etwa ntfy://dein-geheimes-thema oder tgram://TOKEN/CHAT.
# Gemeldet wird nur, wenn der Tagesbericht etwas zu sagen hat, und wenn eine
# Quelle zweimal hintereinander ausfaellt. Leer: keine Benachrichtigung. Den
# Link in der Nachricht setzt "Adresse von Buchfink" auf der Uebersicht.
EBW_NOTIFY_URL=

# Optional. Adresse einer Calibre-Web-Automated-Installation. Gesetzt bekommt
# die Kopfzeile einen Punkt "CWA", der dorthin in einem neuen Tab fuehrt.
# Leer: kein Punkt. Die Adresse gilt nur dort, wo beides laeuft — deshalb
# steht sie hier und nicht im Quelltext (ADR 12).
EBW_CWA_URL=http://books.localhost/
